---
/**
 * The four-step strip on Home: Install → Connect `claude` → Create a company → Give it a
 * goal. One hairline band split into four cells; each cell has an engraved serif numeral
 * (text2 at ≥ 48 px, the large-text exception), a sans title, one sentence and the command
 * that does it, in mono. Four across from 64 em, two across from 40 em, stacked below.
 */
interface Props {
  headingId: string;
}
const { headingId } = Astro.props;

const steps = [
  {
    title: 'Install',
    body: 'Build the Mac app and the brahma CLI from source with Swift 6 on macOS 14 or later. An installer arrives with the first stable release.',
    command: 'swift build',
  },
  {
    title: 'Connect claude',
    body: 'Brahma drives the claude CLI you already use, logged in to your own plan. brahma doctor checks it with a few real probe turns.',
    command: 'brahma doctor',
  },
  {
    title: 'Create a company',
    body: 'A git workspace, channels and a six-agent org from the software pack, all on your Mac.',
    command: 'brahma company create Initech --goal "Build a habit tracker"',
  },
  {
    title: 'Give it a goal',
    body: 'Start the engine and the org works toward the goal: agents claim items, open reviews and merge. Anything only you can decide lands in your Inbox.',
    command: 'brahma run',
  },
];
// Command names in the copy are set in mono.
const codeWords = /(brahma doctor|brahma|claude)/g;
const parts = (text: string) => text.split(codeWords).map((part, i) => ({ text: part, code: i % 2 === 1 }));
---

<ol class="steps" aria-labelledby={headingId}>
  {
    steps.map((step, index) => (
      <li class="step">
        <span class="step__num" aria-hidden="true">
          {index + 1}
        </span>
        <h3 class="step__title">
          <span class="visually-hidden">Step {index + 1}: </span>
          {parts(step.title).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
        </h3>
        <p class="step__body">{parts(step.body).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</p>
        <code class="step__cmd">
          <span class="step__prompt" aria-hidden="true">$</span>
          <span>{step.command}</span>
        </code>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: var(--hairline-strong);
  }
  @media (min-width: 40em) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .step {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-3);
    margin: 0;
    padding: var(--s-5) 0;
    border-bottom: var(--hairline);
    min-width: 0;
  }
  @media (min-width: 40em) {
    .step {
      padding-inline: var(--s-5);
      border-left: var(--hairline);
    }
    .step:nth-child(2n + 1) {
      border-left: 0;
      padding-left: 0;
    }
    .step:nth-child(2n) {
      padding-right: 0;
    }
  }
  @media (min-width: 64em) {
    .step {
      border-bottom: 0;
    }
    .step:nth-child(2n + 1) {
      border-left: var(--hairline);
      padding-left: var(--s-5);
    }
    .step:nth-child(2n) {
      padding-right: var(--s-5);
    }
    .step:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .step:last-child {
      padding-right: 0;
    }
  }
  .step__num {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 0.9;
    color: var(--text2); /* large text: 4.39:1 on bg0, above the 3:1 large-text threshold */
    font-variant-numeric: lining-nums;
  }
  .step__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text0);
  }
  .step__body {
    margin: 0;
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--text1);
    max-width: 38ch;
  }
  .step__title code,
  .step__body code {
    font-size: 0.92em;
    color: var(--text0);
  }
  .step__cmd {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    min-width: 0;
    padding: var(--s-2) var(--s-3);
    background: var(--bg1);
    border: var(--hairline);
    border-radius: var(--radius);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--text0);
    overflow-wrap: anywhere;
  }
  .step__prompt {
    color: var(--text2);
    user-select: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
