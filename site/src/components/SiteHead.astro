---
/**
 * Starlight `Head` override. Emits Starlight's own head entries, then:
 *  - dark-only hints (`color-scheme`, `theme-color`);
 *  - preloads for the three above-the-fold woff2 files (display, sans, mono);
 *  - an Open Graph / Twitter image per site section (PNGs are generated by the OG task).
 * `data-theme="dark"` is set statically on <html> by Starlight; the theme-flipping script
 * (ThemeProvider) is removed in astro.config.mjs so it stays dark.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { site } from '../../site.config.ts';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

const SECTIONS = ['start', 'docs', 'internals', 'api'] as const;
const first = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const section = (SECTIONS as readonly string[]).includes(first) ? first : 'home';
const ogPath = `/og/${section}.png`;
const ogImage = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;
---

<Default />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#0E1217" />
<link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={monoUrl} crossorigin />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.title} — ${site.description}`} />
<meta name="twitter:image" content={ogImage} />
