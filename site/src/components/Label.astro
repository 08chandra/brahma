---
/**
 * Small uppercase tracked label — panel titles, section eyebrows, table headers.
 * 11 px, Inter 600, tracking 0.08em, `text1`. There is no text2 tone: text2 is never a
 * text colour (below AA at label sizes). `tone="accent"` uses the AA link blue.
 */
interface Props {
  as?: 'span' | 'div' | 'h2' | 'h3' | 'p' | 'dt' | 'th';
  tone?: 'default' | 'accent';
  class?: string;
  id?: string;
}
const { as: Tag = 'span', tone = 'default', class: className, id } = Astro.props;
---

<Tag class:list={['label', `label--${tone}`, className]} id={id}><slot /></Tag>

<style>
  .label--accent {
    color: var(--text-link);
  }
</style>
