---
/**
 * Small uppercase tracked label — panel titles, section eyebrows, table headers.
 * 11 px, Inter 600, tracking 0.08em, `text1`. Pass `tone="muted"` for tertiary marks
 * (text2 is below AA for essential text, so use it only for non-essential marks).
 */
interface Props {
  as?: 'span' | 'div' | 'h2' | 'h3' | 'p' | 'dt' | 'th';
  tone?: 'default' | 'muted' | 'accent';
  class?: string;
  id?: string;
}
const { as: Tag = 'span', tone = 'default', class: className, id } = Astro.props;
---

<Tag class:list={['label', `label--${tone}`, className]} id={id}><slot /></Tag>

<style>
  .label--muted {
    color: var(--text2);
  }
  .label--accent {
    color: var(--text-link);
  }
</style>
