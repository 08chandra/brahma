---
/**
 * Status chip: 18 px high, radius 2, 1 px border + 15 % fill of the status colour, a 6 px
 * status dot and a 10 px uppercase label in `text0` (so every chip meets AA regardless of
 * how dark its status colour is). The `running` dot pulses; `killed` is struck through.
 */
type Status = 'running' | 'ready' | 'blocked' | 'sleeping' | 'killed' | 'warning' | 'ok' | 'danger';

interface Props {
  status: Status;
  label?: string;
  class?: string;
}
const { status, label, class: className } = Astro.props;
const colour: Record<Status, string> = {
  running: 'var(--ok)',
  ok: 'var(--ok)',
  ready: 'var(--ready)',
  blocked: 'var(--danger)',
  danger: 'var(--danger)',
  sleeping: 'var(--sleep)',
  killed: 'var(--killed)',
  warning: 'var(--warn)',
};
---

<span
  class:list={['chip', `chip--${status}`, className]}
  style={`--chip: ${colour[status]}`}
  data-status={status}
>
  <span class="chip__dot" aria-hidden="true"></span>
  <span class="chip__label">{label ?? status}</span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 1.125rem; /* 18 px */
    padding: 0 0.4375rem 0 0.375rem;
    border: 1px solid var(--chip);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--chip) 15%, transparent);
    color: var(--text0);
    font-family: var(--font-sans);
    font-size: var(--text-chip);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
    vertical-align: middle;
  }
  .chip__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--chip);
    flex: none;
  }
  .chip--running .chip__dot {
    animation: pulse 1.6s var(--ease) infinite;
  }
  .chip--killed {
    color: var(--text1);
  }
  .chip--killed .chip__label {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .chip--sleeping .chip__dot,
  .chip--killed .chip__dot {
    border: 1px solid var(--text2);
    background: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .chip--running .chip__dot {
      animation: none;
    }
  }
</style>
