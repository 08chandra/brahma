{
  "name": "brahma-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:links": "node scripts/check-links.mjs dist",
    "check:forbidden": "node scripts/check-forbidden.mjs dist",
    "check:generated": "node scripts/check-generated.mjs dist",
    "check:ui": "npm run test:ui",
    "check": "npm run check:links && npm run check:forbidden && npm run check:generated && npm run check:ui",
    "check:lighthouse": "node scripts/lighthouse.mjs dist",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:ui": "node scripts/test-ui.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:all": "node scripts/all-pages.mjs dist | node scripts/screenshots.mjs --serve .reports/screenshots -",
    "screenshots:final": "node scripts/screenshots.mjs --serve .screenshots/final / /start /docs/concepts/companies/ /docs/cli/company/create/ /internals/modules/brahmacore/work/ /404",
    "og": "node scripts/gen-og.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.4.13",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "lighthouse": "13.6.0",
    "playwright": "1.65.1"
  }
}
